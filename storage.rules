rules_version = '2';

// Materiales de clase con marca de agua por alumno.
//
//   materiales/vision-ai/clase-01/{uid}.pdf
//   materiales/vision-ai/clase-02/{uid}.pdf
//
// Cada alumno lee UNICAMENTE el archivo que lleva su uid: si comparte su copia,
// la marca de agua lo identifica y ademas no puede bajar la de otro.
// Nadie escribe desde el cliente: la subida es con el Admin SDK
// (functions/scripts/upload-materials.js).
service firebase.storage {
  match /b/{bucket}/o {

    // La cuenta admin ya existe en Auth, por lo que nadie mas puede registrarse
    // con ese email. Espejo de AVI_ADMIN_EMAILS en assets/firebase-init.js.
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'avi.info.desk@gmail.com';
    }

    function esAlumno() {
      return request.auth != null && request.auth.token.student == true;
    }

    match /materiales/vision-ai/{clase}/{archivo} {
      allow read: if esAdmin()
        || (esAlumno() && archivo == request.auth.uid + '.pdf');
      allow write: if false;
    }

    // Todo lo demas del bucket: cerrado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
