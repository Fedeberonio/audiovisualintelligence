rules_version = '2';

// Preview privado temporal: solo las tres cuentas AVI expresamente habilitadas
// pueden leer materiales. Los claims student/teacher/admin no alcanzan por sí solos.
service cloud.firestore {
  match /databases/{database}/documents {

    function isPrivateAviTeam() {
      return request.auth != null
        && request.auth.token.email in [
          'fede@audiovisualintelligence.ai',
          'academy@audiovisualintelligence.ai',
          'cindytoribiocruz@gmail.com'
        ];
    }

    match /students/{uid} {
      allow read: if false;
      allow write: if false;
    }

    // Copias maestras para lectura online. El enlace solo se entrega a una
    // sesion Firebase con un rol autorizado; Drive vuelve a validar el email.
    match /class_materials/{classId} {
      allow read: if isPrivateAviTeam();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
