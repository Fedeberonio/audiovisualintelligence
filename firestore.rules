rules_version = '2';

// students/{uid} contiene el perfil minimo y los enlaces de Drive autorizados
// para ese alumno. Solo el Admin SDK escribe; el navegador solo lee el documento
// cuyo uid coincide con el token y cuyo claim student es verdadero.
service cloud.firestore {
  match /databases/{database}/documents {

    match /students/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.student == true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
