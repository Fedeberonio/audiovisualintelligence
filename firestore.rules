rules_version = '2';

// students/{uid} contiene el perfil minimo y los enlaces de Drive autorizados
// para ese alumno. Solo el Admin SDK escribe; el navegador solo lee el documento
// cuyo uid coincide con el token y cuyo claim student es verdadero.
service cloud.firestore {
  match /databases/{database}/documents {

    match /students/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.student == true;
      allow write: if false;
    }

    // Copias maestras para lectura online. El enlace solo se entrega a una
    // sesion Firebase con un rol autorizado; Drive vuelve a validar el email.
    match /class_materials/{classId} {
      allow read: if request.auth != null
        && (request.auth.token.student == true
          || request.auth.token.teacher == true
          || request.auth.token.admin == true);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
